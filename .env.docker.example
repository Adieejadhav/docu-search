# Copy to .env.docker for Docker Compose overrides.
# Do not commit real production secrets.

POSTGRES_DB=docusearch
POSTGRES_USER=docusearch
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=55432

DOCKER_DATABASE_URL=postgresql://docusearch:change-me@postgres:5432/docusearch
DATABASE_CONNECT_TIMEOUT_SECONDS=5

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=64

DOCKER_UPLOAD_ROOT=/storage/uploads
DOCKER_INGESTION_RUN_MODE=background

HYBRID_VECTOR_WEIGHT=0.62
HYBRID_LEXICAL_WEIGHT=0.30
HYBRID_PHRASE_WEIGHT=0.08

# Easiest first setup: keep Ollama on the host and let containers call it.
# On Docker Desktop, host.docker.internal resolves to the host machine.
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TEMPERATURE=0

DOCKER_API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174
API_RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_FILES=100
MAX_UPLOAD_FILE_SIZE_BYTES=26214400

# INFO keeps normal app request/startup logs visible.
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
